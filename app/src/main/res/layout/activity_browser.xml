<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_charcoal">

    <!-- WebView -->
    <android.webkit.WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Control Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_bar_height"
        android:background="@color/control_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Back Button -->
        <Button
            android:id="@+id/control_back"
            android:layout_width="@dimen/control_button_min_width"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:minHeight="48dp"
            android:text="@string/control_back"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/control_text_size" />

        <!-- Title (Center) -->
        <TextView
            android:id="@+id/control_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/browser_title_default"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/control_text_size"
            android:textStyle="bold" />

        <!-- Reload Button -->
        <Button
            android:id="@+id/control_reload"
            android:layout_width="@dimen/control_button_min_width"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:minHeight="48dp"
            android:text="@string/control_reload"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/control_text_size" />

        <!-- Home Button -->
        <Button
            android:id="@+id/control_home"
            android:layout_width="@dimen/control_button_min_width"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:minHeight="48dp"
            android:text="@string/control_home"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/control_text_size" />

    </LinearLayout>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/loading_indicator"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/control_bar_height"
        android:progressDrawable="@drawable/progress_bar"
        android:visibility="gone" />

</FrameLayout>
